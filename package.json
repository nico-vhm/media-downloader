{
  "name": "media-downloader",
  "productName": "Media Downloader",
  "version": "2.0.0",
  "description": "YouTube & Spotify Downloader mit Aurora- und Terminal-Design",
  "main": "main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.mediadownloader.app",
    "productName": "Media Downloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Media-Downloader-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Media-Downloader-Portable-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": true
  }
}
